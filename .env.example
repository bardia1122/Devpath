# ---------------------------------------------------------------------------
# DevPath environment variables. Copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Base URL of the app (used for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App
#   Create at: https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Postgres (Supabase / Neon / local). Pooled URL for the app:
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Direct (non-pooled) URL for migrations (drizzle-kit). Often same host, port 5432:
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ---------------------------------------------------------------------------
# AI provider. DevPath generates roadmaps with EITHER Anthropic (Claude) or any
# OpenAI-compatible "Grok" endpoint (Groq Cloud or xAI Grok). You only need one.
#
# Selection order: AI_PROVIDER (if set) > ANTHROPIC_API_KEY > GROK_API_KEY.
# Set AI_PROVIDER to force a choice: "anthropic" or "grok".
# ---------------------------------------------------------------------------
# AI_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Grok / Groq (OpenAI-compatible). Defaults target Groq Cloud.
#   Groq Cloud:  key starts "gsk_",  base https://api.groq.com/openai/v1
#   xAI Grok:    key starts "xai-",  base https://api.x.ai/v1
GROK_API_KEY=
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=llama-3.3-70b-versatile
